#!/bin/sh /etc/rc.common
# zTC1 LAN control daemon.

START=98
STOP=10
USE_PROCD=1

. /usr/share/ztc1/common.sh

start_service() {
	local broadcast dev

	ztc1_load_config
	[ "$ZTC1_ENABLED" = "1" ] || return 0

	broadcast="$(ztc1_resolve_broadcast "$ZTC1_BROADCAST")"
	[ -n "$broadcast" ] || broadcast=255.255.255.255
	dev="$(ztc1_resolve_interface "$ZTC1_BIND_IFACE")"

	mkdir -p "$ZTC1_STATE_DIR" "$ZTC1_COUNTDOWN_DIR" 2>/dev/null

	procd_open_instance "ztc1d"
	procd_set_param command /usr/bin/ucode /usr/share/ztc1/ztc1d.uc \
		"$ZTC1_STATE_DIR" "$ZTC1_LISTEN_PORT" "$ZTC1_COMMAND_PORT" \
		"$broadcast" "$dev" "$ZTC1_SCAN_INTERVAL"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0"
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "ztc1control"
}
