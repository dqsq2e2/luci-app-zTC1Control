#!/bin/sh /etc/rc.common
# zTC1 LAN control daemon and HTTP API.

START=98
STOP=10
USE_PROCD=1

. /usr/share/ztc1/common.sh

ztc1_ensure_api_key() {
	local key

	key="$(uci -q get ztc1control.main.api_key 2>/dev/null)"

	[ -n "$key" ] && return 0

	key="$(head -c 16 /dev/urandom 2>/dev/null | hexdump -v -e '/1 "%02x"' 2>/dev/null | tr -d ' \n')"
	[ -n "$key" ] || key="$(head -c 32 /dev/urandom 2>/dev/null | md5sum 2>/dev/null | cut -d' ' -f1)"
	[ -n "$key" ] || key="ztc1$(date +%s)$$"

	uci -q set ztc1control.main.api_key="$key"
	uci -q commit ztc1control
}

ztc1_api_port_pid() {
	local port="$1"

	command -v netstat >/dev/null 2>&1 || return 1

	netstat -ltnp 2>/dev/null | awk -v p=":$port" '$4 ~ p && $6 == "LISTEN" { split($7, a, "/"); print a[1]; exit }'
}

ztc1_api_wait_port_free() {
	local port="$1" pid cmd i=0

	command -v netstat >/dev/null 2>&1 || return 0

	pid="$(ztc1_api_port_pid "$port")"

	if [ -n "$pid" ] && [ -r "/proc/$pid/cmdline" ]; then
		cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"

		case "$cmd" in
		*"/usr/share/ztc1/www"*)
			logger -t ztc1control "stopping stale API instance on port $port (pid $pid)"
			kill "$pid" 2>/dev/null
			;;
		esac
	fi

	while [ "$i" -lt 5 ]; do
		netstat -ltn 2>/dev/null | grep -q ":$port " || return 0
		i=$((i + 1))
		sleep 1
	done

	return 1
}

start_service() {
	local broadcast dev

	ztc1_load_config
	[ "$ZTC1_ENABLED" = "1" ] || return 0

	broadcast="$(ztc1_resolve_broadcast "$ZTC1_BROADCAST")"
	[ -n "$broadcast" ] || broadcast=255.255.255.255
	dev="$(ztc1_resolve_interface "$ZTC1_BIND_IFACE")"

	mkdir -p "$ZTC1_STATE_DIR" "$ZTC1_COUNTDOWN_DIR" 2>/dev/null

	procd_open_instance "ztc1d"
	procd_set_param command /usr/bin/ucode /usr/share/ztc1/ztc1d.uc \
		"$ZTC1_STATE_DIR" "$ZTC1_LISTEN_PORT" "$ZTC1_COMMAND_PORT" \
		"$broadcast" "$dev" "$ZTC1_SCAN_INTERVAL"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0"
	procd_close_instance

	[ "$ZTC1_API_ENABLED" = "1" ] || return 0

	if ! ztc1_api_wait_port_free "$ZTC1_API_PORT"; then
		logger -t ztc1control "API port $ZTC1_API_PORT is still in use by another service, API not started"
		return 0
	fi

	ztc1_ensure_api_key

	procd_open_instance "ztc1api"
	procd_set_param command /usr/sbin/uhttpd -f \
		-p "0.0.0.0:$ZTC1_API_PORT" \
		-h /usr/share/ztc1/www \
		-x /api \
		-t 30 -T 30 -k 20
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "ztc1control"
}
