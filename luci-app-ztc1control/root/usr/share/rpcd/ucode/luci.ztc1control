#!/usr/bin/ucode
/*
 * rpcd backend for luci-app-ztc1control.
 *
 * The ubus object "luci.ztc1control" is consumed by the LuCI JavaScript
 * views. Device commands are forwarded to /usr/bin/ztc1ctl.
 */

'use strict';

import { readfile, lsdir, unlink, access } from 'fs';
import { popen } from 'fs';
import { cursor } from 'uci';

const STATE_FILE = '/var/run/ztc1/state.json';
const COUNTDOWN_DIR = '/var/run/ztc1/countdown';
const CTL = '/usr/bin/ztc1ctl';
const MAX_NAME_BYTES = 32;
const MAX_PLUG_NAME_CHARS = 16;

function utf8_chars(value) {
	let str = sprintf('%s', value ?? '');
	let count = 0;

	for (let i = 0; i < length(str); i++)
		if ((ord(str, i) & 0xc0) != 0x80)
			count++;

	return count;
}

function to_num(value) {
	if (type(value) == 'int')
		return value;

	if (type(value) == 'double')
		return int(value);

	if (type(value) == 'bool')
		return value ? 1 : 0;

	if (type(value) == 'string' && match(value, /^-?[0-9]+$/))
		return int(value);

	return null;
}

function norm_mac(value) {
	let str = lc(sprintf('%s', value ?? ''));
	let out = '';

	for (let i = 0; i < length(str); i++) {
		let ch = substr(str, i, 1);

		if (match(ch, /[0-9a-f]/))
			out += ch;
	}

	return out;
}

function sanitize_name(value) {
	let str = sprintf('%s', value ?? '');
	let out = '';

	for (let i = 0; i < length(str); i++) {
		let code = ord(str, i);
		let ch = substr(str, i, 1);

		if (code == 9 || code == 10 || code == 13)
			ch = ' ';

		out += ch;
	}

	out = trim(out);

	return out;
}

function shellquote(value) {
	return "'" + replace(sprintf('%s', value), /'/g, "'\\''") + "'";
}

function read_state() {
	let raw = null;

	try {
		raw = readfile(STATE_FILE);
	}
	catch (e) {
		raw = null;
	}

	if (type(raw) == 'string' && length(raw)) {
		try {
			let state = json(raw);

			if (type(state) == 'object')
				return state;
		}
		catch (e) {
			return {};
		}
	}

	return {};
}

function read_names() {
	let names = {};
	let ctx = cursor();
	let config = null;

	try {
		config = ctx.get_all('ztc1control');
	}
	catch (e) {
		config = null;
	}

	if (type(config) != 'object')
		return names;

	for (let section in config) {
		let sec = config[section];

		if (type(sec) != 'object' || sec['.type'] != 'device')
			continue;

		let mac = norm_mac(sec.mac ?? '');

		if (length(mac) != 12)
			continue;

		let plugs = [];

		for (let i = 1; i <= 6; i++)
			push(plugs, sec['plug_' + i] ?? '');

		names[mac] = { name: sec.name ?? '', plugs: plugs };
	}

	return names;
}

function run_ctl(...args) {
	let cmd = CTL;
	let result = { ok: false, code: -1, output: '' };

	for (let i = 0; i < length(args); i++)
		cmd += ' ' + shellquote(args[i]);

	let fd = popen(cmd + ' 2>&1', 'r');

	if (fd == null) {
		result.error = 'unable to execute ztc1ctl';
		return result;
	}

	result.output = trim(fd.read('all') ?? '');
	result.code = fd.close();
	result.ok = (result.code === 0);

	if (type(result.output) == 'string' && length(result.output)) {
		try {
			let parsed = json(result.output);

			if (type(parsed) == 'object') {
				result.data = parsed;

				if (parsed.error != null)
					result.error = sprintf('%s', parsed.error);
			}
		}
		catch (e) {
			/* not JSON, keep raw output */
		}
	}

	return result;
}

function list_countdowns() {
	let files = null;
	let list = [];
	let now = time();

	try {
		files = lsdir(COUNTDOWN_DIR);
	}
	catch (e) {
		files = null;
	}

	if (type(files) != 'array')
		return list;

	for (let i = 0; i < length(files); i++) {
		let name = files[i];

		if (!match(name, /\.json$/))
			continue;

		let job = null;

		try {
			job = json(readfile(COUNTDOWN_DIR + '/' + name));
		}
		catch (e) {
			job = null;
		}

		if (type(job) != 'object')
			continue;

		let due = to_num(job.due);

		if (due == null)
			continue;

		push(list, {
			id: name,
			mac: norm_mac(job.mac ?? ''),
			plug: to_num(job.plug),
			action: to_num(job.action),
			due: due,
			remain: due - now
		});
	}

	return list;
}

function status() {
	let state = read_state();
	let names = read_names();
	let raw_devices = (type(state.devices) == 'array') ? state.devices : [];
	let now = time();
	let devices = [];

	for (let i = 0; i < length(raw_devices); i++) {
		let dev = raw_devices[i];

		if (type(dev) != 'object')
			continue;

		let mac = norm_mac(dev.mac ?? '');

		if (length(mac) != 12)
			continue;

		let override = names[mac] ?? { name: '', plugs: [] };
		let last_seen = to_num(dev.last_seen) ?? 0;
		let online = (last_seen > 0 && now - last_seen < 120);
		let device_name = '';

		/* While the strip is online its reported names are authoritative,
		 * the UCI copy is a fallback for offline devices. */
		if (online && type(dev.device_name) == 'string' && length(dev.device_name))
			device_name = dev.device_name;
		else if (type(override.name) == 'string' && length(override.name))
			device_name = override.name;
		else if (type(dev.device_name) == 'string')
			device_name = dev.device_name;

		let plugs = [];

		for (let j = 0; j < 6; j++) {
			let plug = null;

			if (type(dev.plugs) == 'array' && j < length(dev.plugs))
				plug = dev.plugs[j];

			let plug_name = '';

			if (online && type(plug) == 'object' && type(plug.name) == 'string' && length(plug.name))
				plug_name = plug.name;
			else if (type(override.plugs[j]) == 'string' && length(override.plugs[j]))
				plug_name = override.plugs[j];
			else if (type(plug) == 'object' && type(plug.name) == 'string')
				plug_name = plug.name;

			let entry = {
				index: j,
				name: plug_name,
				on: -1
			};

			if (type(plug) == 'object') {
				if (plug.on != null)
					entry.on = to_num(plug.on) ?? -1;

				for (let t = 0; t < 5; t++) {
					let task = plug['task_' + t];

					if (type(task) == 'object')
						entry['task_' + t] = task;
				}
			}

			push(plugs, entry);
		}

		push(devices, {
			mac: mac,
			name: device_name,
			device_name: dev.device_name ?? '',
			ip: dev.ip ?? '',
			ssid: dev.ssid ?? '',
			version: dev.version ?? '',
			power: sprintf('%s', dev.power ?? ''),
			total_time: to_num(dev.total_time) ?? 0,
			child_lock: (to_num(dev.child_lock) == 1) ? 1 : 0,
			led_lock: (to_num(dev.led_lock) == 1) ? 1 : 0,
			lock_state: (dev.lock_state === true),
			last_seen: last_seen,
			online: (last_seen > 0 && now - last_seen < 120),
			type: to_num(dev.type) ?? 0,
			type_name: dev.type_name ?? '',
			plugs: plugs
		});
	}

	let ctx = cursor();
	let enabled = false;

	try {
		enabled = (ctx.get('ztc1control', 'main', 'enabled') == '1');
	}
	catch (e) {
		enabled = false;
	}

	return {
		ok: true,
		now: now,
		updated: to_num(state.updated) ?? 0,
		service: {
			enabled: enabled,
			running: (system('/etc/init.d/ztc1control status >/dev/null 2>&1') === 0)
		},
		devices: devices,
		countdowns: list_countdowns()
	};
}

function rename_device(mac, name, plugs) {
	if (length(mac) != 12)
		return { ok: false, error: 'invalid MAC address' };

	let device_name = sanitize_name(name);
	let plug_names = [];

	if (length(device_name) > MAX_NAME_BYTES)
		return { ok: false, error: '设备名称不能超过 32 个字节' };

	for (let i = 0; i < 6; i++) {
		let plug_name = '';

		if (type(plugs) == 'array' && i < length(plugs))
			plug_name = sanitize_name(plugs[i]);

		if (length(plug_name) && utf8_chars(plug_name) > MAX_PLUG_NAME_CHARS)
			return { ok: false, error: '插口名称不能超过 16 个字符' };

		push(plug_names, plug_name);
	}

	let ctx = cursor();
	let section = null;
	let config = ctx.get_all('ztc1control') ?? {};

	for (let sid in config) {
		let sec = config[sid];

		if (type(sec) == 'object' && sec['.type'] == 'device' && norm_mac(sec.mac ?? '') == mac) {
			section = sid;
			break;
		}
	}

	if (section == null)
		section = ctx.add('ztc1control', 'device');

	if (section == null)
		return { ok: false, error: 'unable to create device section' };

	ctx.set('ztc1control', section, 'mac', mac);
	ctx.set('ztc1control', section, 'name', device_name);

	for (let i = 0; i < 6; i++)
		ctx.set('ztc1control', section, 'plug_' + (i + 1), plug_names[i]);

	let committed = ctx.commit('ztc1control');

	if (committed == null || committed === false)
		return { ok: false, error: 'unable to save configuration' };

	/* Names are also written into the power strip itself when possible. */
	let remote = run_ctl('rename', mac, device_name,
		plug_names[0], plug_names[1], plug_names[2],
		plug_names[3], plug_names[4], plug_names[5]);

	let sent = 0;

	if (remote.ok === true && type(remote.data) == 'object')
		sent = to_num(remote.data.sent) ?? 0;

	return {
		ok: true,
		section: section,
		sent: sent,
		message: (sent > 0)
			? '名称已保存并发送到排插'
			: '名称已保存到本地，发送到排插失败'
	};
}

const methods = {
	status: {
		call: function() {
			return status();
		}
	},

	scan: {
		call: function() {
			return run_ctl('scan');
		}
	},

	query: {
		args: { mac: 'x' },
		call: function(request) {
			return run_ctl('query', norm_mac(request.args.mac ?? ''));
		}
	},

	plug: {
		args: { mac: 'x', plug: 0, on: 0 },
		call: function(request) {
			let mac = norm_mac(request.args.mac ?? '');
			let plug = to_num(request.args.plug);
			let on = to_num(request.args.on);

			if (length(mac) != 12 || plug == null || plug < 0 || plug > 5 || on == null)
				return { ok: false, error: 'invalid arguments' };

			return run_ctl('plug', mac, sprintf('%d', plug), (on == 1) ? '1' : '0');
		}
	},

	locks: {
		args: { mac: 'x', child_lock: 0, led_lock: 0 },
		call: function(request) {
			let mac = norm_mac(request.args.mac ?? '');
			let child = to_num(request.args.child_lock);
			let led = to_num(request.args.led_lock);

			if (length(mac) != 12 || child == null || led == null)
				return { ok: false, error: 'invalid arguments' };

			return run_ctl('locks', mac, (child == 1) ? '1' : '0', (led == 1) ? '1' : '0');
		}
	},

	activate: {
		args: { mac: 'x', code: 'x' },
		call: function(request) {
			let mac = norm_mac(request.args.mac ?? '');
			let code = sprintf('%s', request.args.code ?? '');

			if (length(mac) != 12 || !length(code))
				return { ok: false, error: 'invalid arguments' };

			return run_ctl('activate', mac, code);
		}
	},

	timer: {
		args: { mac: 'x', plug: 0, task: 0, hour: 0, minute: 0, repeat: 127, action: 0, enable: 0 },
		call: function(request) {
			let mac = norm_mac(request.args.mac ?? '');
			let plug = to_num(request.args.plug);
			let task = to_num(request.args.task);
			let hour = to_num(request.args.hour);
			let minute = to_num(request.args.minute);
			let repeat = to_num(request.args.repeat);
			let action = to_num(request.args.action);
			let enable = to_num(request.args.enable);

			if (length(mac) != 12 || plug == null || task == null || hour == null ||
			    minute == null || repeat == null || action == null || enable == null)
				return { ok: false, error: 'invalid arguments' };

			return run_ctl('timer', mac,
				sprintf('%d', plug), sprintf('%d', task),
				sprintf('%d', hour), sprintf('%d', minute),
				sprintf('%d', repeat), sprintf('%d', action),
				sprintf('%d', enable));
		}
	},

	countdown: {
		args: { mac: 'x', plug: 0, seconds: 300, action: 0 },
		call: function(request) {
			let mac = norm_mac(request.args.mac ?? '');
			let plug = to_num(request.args.plug);
			let seconds = to_num(request.args.seconds);
			let action = to_num(request.args.action);

			if (length(mac) != 12 || plug == null || plug < 0 || plug > 5 ||
			    seconds == null || seconds < 1 || seconds > 604800 ||
			    action == null || action < 0 || action > 1)
				return { ok: false, error: 'invalid arguments' };

			return run_ctl('countdown', mac, sprintf('%d', plug),
				sprintf('%d', seconds), sprintf('%d', action));
		}
	},

	cancel_countdown: {
		args: { id: 'x' },
		call: function(request) {
			let id = sprintf('%s', request.args.id ?? '');

			if (!length(id) || !match(id, /^[0-9A-Za-z_.-]+$/) || !match(id, /\.json$/))
				return { ok: false, error: 'invalid countdown id' };

			let removed = null;

			try {
				removed = unlink(COUNTDOWN_DIR + '/' + id);
			}
			catch (e) {
				removed = null;
			}

			return { ok: (removed != null) };
		}
	},

	rename: {
		args: { mac: 'x', name: 'x', plugs: [] },
		call: function(request) {
			return rename_device(norm_mac(request.args.mac ?? ''),
				request.args.name ?? '', request.args.plugs ?? []);
		}
	}
};

return { 'luci.ztc1control': methods };
